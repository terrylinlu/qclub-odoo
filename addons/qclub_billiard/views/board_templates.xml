<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="board_page" model="ir.ui.view">
        <field name="name">Board</field>
        <field name="key">qclub_billiard.board_page</field>
        <field name="type">qweb</field>
        <field name="model">qclub.booking</field>
        <field name="arch" type="xml">
            <t t-name="qclub_billiard.board_page" t-call="website.layout">
                <div id="wrap" class="o_qclub_board container py-4">
                    <h1>Board</h1>
                    <p>Player posts are coming soon.</p>
                    <p t-if="profile_data">Your nickname: <span t-out="profile_data['nickname']"/></p>
                    <a href="/billiard/board/nickname" class="btn btn-primary">Set or change nickname</a>
                </div>
            </t>
        </field>
    </record>
    <record id="board_nickname" model="ir.ui.view">
        <field name="name">Board Nickname</field>
        <field name="key">qclub_billiard.board_nickname</field>
        <field name="type">qweb</field>
        <field name="model">qclub.booking</field>
        <field name="arch" type="xml">
            <t t-name="qclub_billiard.board_nickname" t-call="website.layout">
                <div id="wrap" class="container py-4">
                    <h1>Set your nickname</h1>
                    <p>Use 2 to 20 ASCII letters, numbers, spaces, underscores or hyphens. Don't use personal contact details.</p>
                    <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
                    <form action="/billiard/board/nickname" method="post" class="col-12 col-md-6">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="next" t-att-value="next_path"/>
                        <label for="board_nickname" class="form-label">Nickname</label>
                        <input id="board_nickname" type="text" name="nickname" t-att-value="nickname" class="form-control mb-3" required="required"/>
                        <button type="submit" class="btn btn-primary">Save nickname</button>
                    </form>
                </div>
            </t>
        </field>
    </record>
</odoo>
