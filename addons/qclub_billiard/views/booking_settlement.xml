<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="booking_settle_form" model="ir.ui.view">
        <field name="name">qclub.booking.settle.form</field>
        <field name="model">qclub.booking.settle</field>
        <field name="arch" type="xml">
            <form string="Settle">
                <group>
                    <field name="mode" invisible="True"/>
                    <field name="currency_id" invisible="True"/>
                    <field name="booking_id"/>
                    <field name="table_fee" string="Booked table fee"/>
                    <field name="paid_amount" string="Deposit paid"/>
                    <field name="actual_table_fee"/>
                    <field name="reason" required="mode == 'correct' or actual_table_fee != table_fee"/>
                    <field name="balance_due" string="Balance to collect"/>
                    <field name="method" required="balance_due &gt; 0" invisible="balance_due == 0"/>
                </group>
                <p invisible="mode != 'settle'">A reason is required when changing the booked table fee.</p>
                <p invisible="mode != 'correct'">A reason is required for every settlement correction.</p>
                <p class="alert alert-warning" invisible="actual_table_fee &gt;= paid_amount">
                    Balance is $0. The deposit above the actual table fee is not refunded.
                </p>
                <footer>
                    <button name="action_confirm_settlement" string="Settle" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="booking_settle_correct_form" model="ir.ui.view">
        <field name="name">qclub.booking.correct.form</field>
        <field name="model">qclub.booking.settle</field>
        <field name="arch" type="xml">
            <form string="Correct Settlement">
                <group>
                    <field name="mode" invisible="True"/>
                    <field name="currency_id" invisible="True"/>
                    <field name="booking_id"/>
                    <field name="table_fee" string="Booked table fee"/>
                    <field name="paid_amount" string="Deposit paid"/>
                    <field name="actual_table_fee"/>
                    <field name="reason" required="mode == 'correct' or actual_table_fee != table_fee"/>
                    <field name="balance_due" string="Balance to collect"/>
                    <field name="method" required="balance_due &gt; 0" invisible="balance_due == 0"/>
                </group>
                <p invisible="mode != 'settle'">A reason is required when changing the booked table fee.</p>
                <p invisible="mode != 'correct'">A reason is required for every settlement correction.</p>
                <p class="alert alert-warning" invisible="actual_table_fee &gt;= paid_amount">
                    Balance is $0. The deposit above the actual table fee is not refunded.
                </p>
                <footer>
                    <button name="action_confirm_correction" string="Correct Settlement" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
