<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Billiard settings, one record per website (CFG-001, CFG-002, CFG-004) -->
    <record id="qclub_config_view_list" model="ir.ui.view">
        <field name="name">qclub.config.list</field>
        <field name="model">qclub.config</field>
        <field name="arch" type="xml">
            <list string="Billiard Settings">
                <field name="website_id"/>
                <field name="deposit_ratio"/>
                <field name="free_cancel_hours"/>
                <field name="no_show_wait_minutes"/>
                <field name="lock_minutes"/>
                <field name="max_consecutive_hours"/>
                <field name="max_advance_days"/>
            </list>
        </field>
    </record>

    <record id="qclub_config_view_form" model="ir.ui.view">
        <field name="name">qclub.config.form</field>
        <field name="model">qclub.config</field>
        <field name="arch" type="xml">
            <form string="Billiard Settings">
                <header>
                    <field name="has_opening_hours" invisible="1"/>
                    <button name="action_load_default_opening_hours" type="object"
                            string="Load Default Opening Hours"
                            groups="qclub_billiard.group_billiard_manager" invisible="has_opening_hours"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="website_id"/>
                        <h1><field name="website_id" options="{'no_create': True, 'no_open': True}"/></h1>
                    </div>
                    <div class="text-muted mb-3">
                        Changes only apply to new bookings. Existing bookings keep the values in force when they were made.
                    </div>
                    <group string="Website Availability">
                        <field name="online_booking"/>
                        <field name="occupancy_requires_login"/>
                    </group>
                    <group>
                        <group string="Deposit and Cancellation">
                            <field name="deposit_ratio"/>
                            <field name="free_cancel_hours"/>
                            <field name="no_show_wait_minutes"/>
                        </group>
                        <group string="Booking Limits">
                            <field name="lock_minutes"/>
                            <field name="max_consecutive_hours"/>
                            <field name="max_advance_days"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="qclub_config_action" model="ir.actions.act_window">
        <field name="name">Billiard Settings</field>
        <field name="res_model">qclub.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the billiard settings for a website</p>
            <p>Deposit percentage, cancellation window, no-show wait and booking limits.</p>
        </field>
    </record>
</odoo>
