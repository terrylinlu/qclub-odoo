<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="qclub_booking_view_list" model="ir.ui.view">
        <field name="name">qclub.booking.list</field>
        <field name="model">qclub.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="create_date" string="Booked On"/>
                <field name="business_date"/>
                <field name="table_id"/>
                <field name="partner_id"/>
                <field name="created_in_cancel_window"/>
                <field name="booking_channel"/>
                <field name="start"/>
                <field name="end"/>
                <field name="duration_hours"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="deposit_amount"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'" decoration-info="state == 'confirmed'"
                       decoration-primary="state == 'arrived'" decoration-success="state == 'done'"
                       decoration-muted="state in ('cancelled', 'expired')" decoration-danger="state == 'no_show'"/>
            </list>
        </field>
    </record>
    <record id="qclub_booking_view_form" model="ir.ui.view">
        <field name="name">qclub.booking.form</field>
        <field name="model">qclub.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight"
                            groups="qclub_billiard.group_billiard_staff" invisible="state != 'pending'"/>
                    <button name="action_arrive" string="Mark Arrived" type="object"
                            groups="qclub_billiard.group_billiard_staff" invisible="state != 'confirmed'"/>
                    <button name="action_complete" string="Complete" type="object"
                            groups="qclub_billiard.group_billiard_staff" invisible="state != 'arrived'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            groups="qclub_billiard.group_billiard_staff"
                            invisible="state not in ('pending', 'confirmed')"/>
                    <button name="action_no_show" string="No-show" type="object"
                            groups="qclub_billiard.group_billiard_staff" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,confirmed,arrived,done"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <field name="currency_id" invisible="True"/>
                    <group>
                        <field name="table_id" domain="[('active', '=', True)]"
                               readonly="state not in ('pending', 'confirmed')"/>
                        <field name="partner_id"/>
                        <field name="created_in_cancel_window"/>
                        <field name="booking_channel"/>
                        <field name="start" invisible="True" readonly="True" force_save="1"/>
                        <field name="start_date" string="Business Date" readonly="state not in ('pending', 'confirmed')"/>
                        <field name="start_hour" readonly="state not in ('pending', 'confirmed')"/>
                        <field name="duration_hours" readonly="state not in ('pending', 'confirmed')"/>
                        <field name="end" readonly="True"/>
                        <field name="business_date" readonly="True" invisible="True"/>
                        <field name="lock_expire" readonly="True" invisible="not lock_expire"/>
                        <field name="create_date" string="Booked On" readonly="True" invisible="not create_date"/>
                    </group>
                    <group string="Price snapshot">
                        <field name="hourly_price" readonly="True"/>
                        <field name="deposit_ratio" readonly="True"/>
                        <field name="free_cancel_hours" readonly="True"/>
                        <field name="no_show_wait_minutes" readonly="True"/>
                        <field name="table_fee" readonly="True"/>
                        <field name="deposit_amount" readonly="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="qclub_booking_view_calendar" model="ir.ui.view">
        <field name="name">qclub.booking.calendar</field>
        <field name="model">qclub.booking</field>
        <field name="arch" type="xml">
            <calendar date_start="start" date_stop="end" color="table_id" mode="week" quick_create="False">
                <field name="name"/>
                <field name="table_id"/>
                <field name="partner_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>
    <record id="qclub_booking_view_search" model="ir.ui.view">
        <field name="name">qclub.booking.search</field>
        <field name="model">qclub.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="table_id"/>
                <filter name="active" string="Active" domain="[('state', 'in', ('pending', 'confirmed', 'arrived'))]"/>
                <separator/>
                <filter name="pending" string="Awaiting Deposit" domain="[('state', '=', 'pending')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="arrived" string="Arrived" domain="[('state', '=', 'arrived')]"/>
                <filter name="done" string="Completed" domain="[('state', '=', 'done')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="no_show" string="No-show" domain="[('state', '=', 'no_show')]"/>
                <separator/>
                <filter name="business_date" string="Business Date" date="business_date"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_table_id" string="Table" context="{'group_by': 'table_id'}"/>
                    <filter name="group_business_date" string="Business Date" context="{'group_by': 'business_date'}"/>
                    <filter name="group_create_date" string="Booked On" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="qclub_booking_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">qclub.booking</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="qclub_booking_view_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
