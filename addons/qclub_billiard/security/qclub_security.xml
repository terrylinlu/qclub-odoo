<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SEC-001: Billiard Staff / Billiard Manager -->
    <record id="res_groups_privilege_billiard" model="res.groups.privilege">
        <field name="name">Billiards</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_billiard_staff" model="res.groups">
        <field name="name">Billiard Staff</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_billiard"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Views tables and settings; from task 1.3 on, views and handles all bookings.</field>
    </record>

    <record id="group_billiard_manager" model="res.groups">
        <field name="name">Billiard Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_billiard"/>
        <field name="implied_ids" eval="[(4, ref('group_billiard_staff'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Manages tables, table types and billiard settings.</field>
    </record>
</odoo>
